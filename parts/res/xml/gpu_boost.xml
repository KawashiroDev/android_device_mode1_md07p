    <com.android.settingslib.widget.MainSwitchPreference
        android:key="gpu_boost"
        android:title="@string/gpu_boost_switch" />

    <CheckBoxPreference
        android:key="gpu_boost_keep"
        android:title="@string/gpu_boost_keep_title"
