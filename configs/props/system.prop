# ADB
ro.adb.secure.recovery=0

# Media
debug.stagefright.c2inputsurface=-1
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.mtk_thumbnail_optimization=true

# Storage
persist.sys.fuse.passthrough.enable=true

# Audio
ro.audio.usb.period_us=16000
vendor.audio.cpu.littlecore=true
vendor.audio.cpu.mask=0x3f
vendor.audio.cpus=8
vendor.audiomediatek.cpu.littlecore=true
vendor.audiomediatek.cpu.mask=0x3f

# Kernel
ro.kernel.zio=38,108,105,16

# Connectivity
ro.mediatek.wlan.p2p=1
ro.mediatek.wlan.wsc=1
wifi.direct.interface=p2p0
wifi.interface=wlan0
wifi.tethering.interface=ap0

# Dexopt
dalvik.vm.dex2oat64.enabled=true
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot=verify
pm.dexopt.first-boot=verify
pm.dexopt.ab-ota=speed-profile
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.dex2oat-threads=6
dalvik.vm.boot-dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.boot-dex2oat-threads=6
dalvik.vm.image-dex2oat-cpu-set=0,1,2,3,4,5
dalvik.vm.image-dex2oat-threads=6

# Logging
persist.log.tag.BLASTBufferQueue=S

# Netflix
ro.netflix.channel=004ee050-1a17-11e9-bb61-6f1da27fb55b
ro.netflix.signup=1

# Graphics
ro.opengles.version=196610
ro.surface_flinger.supports_background_blur=1
ro.sf.blurs_are_expensive=1

# HWUI
debug.hwui.skia_atrace_enabled=false

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# Mediatek
ro.vendor.mtk_cta_set=1
ro.vendor.mtk_flv_playback_support=1
ro.vendor.mtk_telephony_add_on_policy=0

# FM radio (MT6631). LineageOS's FMRadio reads its tuning from ro.fm.* and rejects every
# frequency without them. Japan wideband (76.0-108.0 MHz); stock's app covers 76.0-99.0.
# Needs patches/packages_apps_FMRadio-0001-band-from-props.patch for the app's 76 MHz floor.
ro.fm.chip=0x6631
ro.fm.band=3
ro.fm.low_band=760
ro.fm.high_band=1080
ro.fm.seek_space=1
ro.fm.max_scan_num=40
ro.fm.seek_lev=4
ro.fm.scan_sort=0
ro.fm.short_ana_sup=0
ro.fm.rssi_th_l2=-102
ro.fm.fake_chans=0

# Needed on this GPU: without it the boot animation (and every BLASTBufferQueue client) can deadlock
# in setMaxDequeuedBufferCount and nothing is ever drawn. Set here rather than vendor.prop because
# the property has no vendor-settable SELinux context.
ro.surface_flinger.max_acquired_buffers=2
