cc_library_shared {
    name: "libshim_sensors",
    whole_static_libs: [
        "android.hardware.sensors@1.0-convert"
    ],
    shared_libs: [
        "libhardware",
        "libhidlbase",
        "android.hardware.sensors@1.0"
    ],
    vendor: true
}

cc_library_shared {
    name: "libshim_nfc",
    srcs: ["nfc_shim.cpp"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_vtsource",
    srcs: ["vtsource_shim.cpp"],
    shared_libs: [
        "libgui",
        "liblog",
        "libui",
        "libutils",
    ],
    system_ext_specific: true,
    // libsource.so is 64-bit only, and the layout constants are for LP64.
    compile_multilib: "64",
}
