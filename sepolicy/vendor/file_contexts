# Graphics
/sys/devices/virtual/mi_display/disp_feature/disp-DSI-+[0-1](/.*)?         u:object_r:vendor_sysfs_displayfeature:s0

# Lights
/(vendor|system/vendor)/bin/hw/android\.hardware\.light-service\.mode1 u:object_r:hal_light_default_exec:s0

# Power
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.pixel-libperfmgr u:object_r:hal_power_default_exec:s0

# Sensors
/vendor/bin/hw/android\.hardware\.sensors-service\.mode1-multihal u:object_r:hal_sensors_default_exec:s0
/vendor/bin/hw/android\.hardware\.sensors-service\.multihal        u:object_r:hal_sensors_default_exec:s0

# Thermal

# Touch panel gesture
/sys/devices/virtual/touch/touch_dev/gesture_double_tap_state u:object_r:sysfs_tp_gesture:s0


# Fingerprint (MicroArray)
/dev/madev0 u:object_r:fingerprint_device:s0

# Vibrator (stock Awinic HAL, renamed to avoid clashing with hardware/mediatek's module)
/(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator-service\.mediatek-awinic u:object_r:hal_vibrator_default_exec:s0

# TrustKernel keybox check (started by trustkernel.rc), same label as stock
/(vendor|system/vendor)/bin/tee_check_keybox u:object_r:tee_exec:s0
