diff --git a/libc/bionic/spawn.cpp b/libc/bionic/spawn.cpp
index f1b8eb0..00ac9e7 100644
--- a/libc/bionic/spawn.cpp
+++ b/libc/bionic/spawn.cpp
@@ -114,6 +114,41 @@ struct __posix_spawnattr {
   } sigmask, sigdefault;
 };
 
+// Fallback for kernels without CLOSE_RANGE_CLOEXEC (< 5.11): walk /proc/self/fd
+// with raw getdents64 into a stack buffer (no malloc: we may be in a vfork child).
+struct spawn_dirent64 {
+  uint64_t d_ino;
+  int64_t d_off;
+  unsigned short d_reclen;
+  unsigned char d_type;
+  char d_name[];
+};
+
+static bool cloexec_fds_from_proc() {
+  int dir_fd = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir_fd == -1) return false;
+  char buf[1024] __attribute__((aligned(8)));
+  while (true) {
+    long n = syscall(__NR_getdents64, dir_fd, buf, sizeof(buf));
+    if (n < 0) {
+      close(dir_fd);
+      return false;
+    }
+    if (n == 0) break;
+    for (long off = 0; off < n;) {
+      const spawn_dirent64* d = reinterpret_cast<const spawn_dirent64*>(buf + off);
+      off += d->d_reclen;
+      int fd = 0;
+      const char* p = d->d_name;
+      if (*p < '0' || *p > '9') continue;
+      for (; *p >= '0' && *p <= '9'; ++p) fd = fd * 10 + (*p - '0');
+      if (fd >= 3 && fd != dir_fd) fcntl(fd, F_SETFD, FD_CLOEXEC);
+    }
+  }
+  close(dir_fd);
+  return true;
+}
+
 static void ApplyAttrs(short flags, const posix_spawnattr_t* attr) {
   // POSIX: "If POSIX_SPAWN_SETSIGDEF is set ... signals in sigdefault ...
   // shall be set to their default actions in the child process."
@@ -154,7 +189,11 @@ static void ApplyAttrs(short flags, const posix_spawnattr_t* attr) {
 
   if ((flags & POSIX_SPAWN_CLOEXEC_DEFAULT) != 0) {
     // mark all open fds except stdin/out/err as close-on-exec
-    if (close_range(3, ~0U, CLOSE_RANGE_CLOEXEC)) _exit(127);
+    if (close_range(3, ~0U, CLOSE_RANGE_CLOEXEC)) {
+      // CLOSE_RANGE_CLOEXEC needs Linux 5.11; older kernels return EINVAL.
+      if (errno != EINVAL && errno != ENOSYS) _exit(127);
+      if (!cloexec_fds_from_proc()) _exit(127);
+    }
   }
 }
 
