+        if (baseSs.getState() != ServiceState.STATE_IN_SERVICE && isModemVowifiActive()) {
+            ServiceState ss = mergeVoiceServiceStates(baseSs, imsSs,
+                    ServiceState.STATE_IN_SERVICE);
+            if (ss == baseSs) ss = new ServiceState(baseSs);
+            ss.addNetworkRegistrationInfo(new android.telephony.NetworkRegistrationInfo.Builder()
+                    .setDomain(android.telephony.NetworkRegistrationInfo.DOMAIN_PS)
+                    .setTransportType(android.telephony.AccessNetworkConstants.TRANSPORT_TYPE_WLAN)
+                    .setRegistrationState(
+                            android.telephony.NetworkRegistrationInfo.REGISTRATION_STATE_HOME)
+                    .setAccessNetworkTechnology(TelephonyManager.NETWORK_TYPE_IWLAN)
+                    .build());
+            ss.setIwlanPreferred(true);
+            ss.setDataRegState(ServiceState.STATE_IN_SERVICE);
+            return ss;
+        }
         return mergeVoiceServiceStates(baseSs, imsSs, mTelecomVoiceServiceStateOverride);
     }
 
